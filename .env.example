# Copy to .env and fill in what you use. Nothing here is required for a
# regex-only run — `python cli.py run --no-notify` works with an empty .env.

# --- LLM (optional; leave unset to run regex-only, or point at Ollama) ---
OPENAI_API_KEY=
# LLM_API_KEY=            # takes precedence over OPENAI_API_KEY
# LLM_BASE_URL=http://localhost:11434/v1     # Ollama / LM Studio / OpenRouter / Groq
# LLM_MODEL=llama3.1:8b
# LLM_ENABLED=false

# --- Email (any SMTP: Gmail app password, Mailtrap, Postmark, SES) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL="Scholarship Bot <you@gmail.com>"
TO_EMAIL=you@gmail.com

# --- Telegram (create a bot with @BotFather; get chat id from @userinfobot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Slack / Discord / ntfy.sh webhook ---
WEBHOOK_URL=

# --- Dashboard links in the email footer + opt-out tokens ---
DASHBOARD_URL=https://yourname.github.io/scholarship-tracker
DIGEST_SECRET=change-me-to-a-random-string

# --- Optional: override anything in config.yaml ---
# SCHOLARSHIP__profile__ielts=8.0
# SCHOLARSHIP__llm__enabled=false
# SCHOLARSHIP__notify__dry_run=true
# DATABASE_URL=postgresql://user:pass@host/db   # swap SQLite for Postgres
